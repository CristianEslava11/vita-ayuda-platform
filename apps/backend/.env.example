NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000
# Completar con la URI de Session pooler (5432), con sslmode=require.
DATABASE_URL=
# npm run setup:env genera un secreto aleatorio si este valor esta vacio.
JWT_SECRET=
JWT_ISSUER=vita-ayuda-backend
JWT_AUDIENCE=vita-ayuda-frontend
# true permite varios registros para la demostracion; false conserva el monitoreo diario.
MONITORING_DEMO_MODE=false
