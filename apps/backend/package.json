{
  "name": "@vita-ayuda/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run prisma:generate && nest build",
    "start:dev": "npm run prisma:generate && nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema=src/prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema=src/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=src/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=src/prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.0.0",
    "@vita-ayuda/config": "*",
    "@vita-ayuda/database": "*",
    "@vita-ayuda/shared": "*",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "prisma": "^6.0.0"
  }
}
